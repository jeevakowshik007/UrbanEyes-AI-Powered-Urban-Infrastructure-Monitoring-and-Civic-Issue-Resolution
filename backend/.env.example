APP_ENV=dev
DATABASE_URL=sqlite:///./urbaneyes_dev.db
# Production: postgresql+psycopg://urbaneyes:CHANGE_ME@db:5432/urbaneyes
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=30
JWT_SECRET=CHANGE_ME_generate_32plus_random_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
CV_PROVIDER=mock
# CV_PROVIDER=yolo when real YOLO26-Seg weights are configured
REASONING_PROVIDER=local
REASONING_SCORE_CRITICAL=0.60
REASONING_SCORE_MEDIUM=0.32
MEDIUM_REQUEST_MIN_FINDINGS=3
YOLO26_SEG_WEIGHTS=./weights/yolo26-seg.pt
YOLO26_CONF=0.35
YOLO26_DEVICE=cpu
YOLO26_IMGSZ=640
YOLO26_IOU=0.7
YOLO26_MAX_DET=100
YOLO26_HALF=false
FRAME_SAMPLE_COUNT=12
# Sampling is deterministic count-based (evenly spaced frames).
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=urbaneyes
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PRESIGN_EXPIRY_S=3600
EVIDENCE_MAX_MB=25
REDIS_URL=
TASK_EAGER=true
MAX_UPLOAD_MB=500
PAGE_MAX_LIMIT=200
SEED_DEMO=true
